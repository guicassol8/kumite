{
  "name": "@kumite/back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "kata verify",
    "hurl": "hurl --test --color --variable host=${HURL_HOST:-http://localhost:3000} src/modules/*/*.hurl",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13",
    "@katajs-framework/core": "^0.3.2",
    "drizzle-orm": "^0.44.0",
    "hono": "^4",
    "postgres": "^3.4",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19",
    "typescript": "^5.6",
    "vitest": "^4.1.7"
  }
}
