{
  "name": "@kumite/back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "predev": "node scripts/build-sandbox-worker.mjs",
    "dev": "tsx watch src/main.ts",
    "prestart": "node scripts/build-sandbox-worker.mjs",
    "start": "tsx src/main.ts",
    "pretest": "node scripts/build-sandbox-worker.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "kata verify",
    "hurl": "hurl --test --jobs 1 --color --error-format long --variable host=${HURL_HOST:-http://localhost:3000} --variable organizer_email=${ORGANIZER_EMAIL} --variable organizer_password=${ORGANIZER_PASSWORD} src/modules/*/*.hurl",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1127.0",
    "@hono/node-server": "^1.13",
    "@katajs-framework/core": "^0.4.2",
    "@kumite/blocks": "workspace:*",
    "argon2": "^0.45.1",
    "blockly": "^13.2.1",
    "drizzle-orm": "^0.44.0",
    "hono": "^4",
    "postgres": "^3.4",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19",
    "typescript": "^5.6",
    "vitest": "^4.1.7"
  }
}
