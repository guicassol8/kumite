{
  "name": "kumite",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:back": "pnpm --filter @kumite/back dev",
    "dev:front": "pnpm --filter @kumite/front dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm --filter @kumite/back exec kata verify --strict-coverage",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm verify && pnpm test",
    "e2e": "bash scripts/e2e.sh",
    "worktree:prune": "bash scripts/worktree-prune.sh",
    "worktree:env": "bash scripts/worktree-env.sh",
    "load": "pnpm --filter @kumite/back load",
    "load:baseline": "pnpm --filter @kumite/back load baseline",
    "load:smoke": "pnpm --filter @kumite/back load smoke",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "lefthook": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "lefthook"
    ]
  }
}
