# Copy to .env for local development. Every value marked (required) has no
# default — nothing that reads it starts without one. All the others can be
# left exactly as they are here.

# Postgres from the repo root's docker-compose.yml (docker compose up -d)
DATABASE_URL=postgres://kumite:kumite@localhost:5433/kumite

# HTTP port for the API
PORT=3000

# Public origin of the front, used to build the absolute link inside the
# password-reset email (${APP_BASE_URL}/reset-password, src/modules/notifications).
# Optional — blank falls back to the local Vite origin below. In production it
# is the deployed front URL (see docs/deploy-checklist.md § 6). No trailing
# slash: one is stripped anyway, but the value is clearer without it.
APP_BASE_URL=http://localhost:5173

# (required) Secret used to sign/verify JWTs (see the `@katajs-framework/core/jwt`
# guide). The API aborts at startup while this is empty.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# (required by `pnpm db:seed` only) Initial organizer account. Not read
# anywhere else, so `pnpm dev` and `pnpm test` run fine without these two.
ORGANIZER_EMAIL=
ORGANIZER_PASSWORD=

# Judge sandbox limits (src/modules/judge). All optional — defaults match
# #15's operational limits.
JUDGE_TIMEOUT_MS=2000
JUDGE_MEMORY_MB=64
JUDGE_CONCURRENCY=4

# Submission anti-abuse (src/modules/submissions). Cooldown between two
# submissions of the same identity (team when there is one, else user), and
# the max request body accepted by POST /submissions (256KB).
SUBMISSION_COOLDOWN_MS=5000
SUBMISSION_MAX_BODY_BYTES=262144

# Password-reset anti-abuse (src/modules/password-reset, #142). One sliding
# window shared by both routes: at most MAX_PER_EMAIL requests for the same
# address and MAX_PER_IP from the same client on
# POST /auth/request-password-reset, plus COMPLETE_MAX_PER_IP on
# POST /auth/complete-password-reset. Over the ceiling the routes answer
# exactly as they always do (204 / 400 invalid_otp) — telling the caller it
# was throttled would recreate the account-existence oracle these routes
# are built to avoid. Only accepted requests count, so the window drains
# 15 min after the last one that got through.
PASSWORD_RESET_WINDOW_MS=900000
PASSWORD_RESET_MAX_PER_EMAIL=3
PASSWORD_RESET_MAX_PER_IP=20
PASSWORD_RESET_COMPLETE_MAX_PER_IP=30

# Organizer step-up ceiling (src/modules/password-reset, #143). Wrong admin
# passwords tolerated per organizer on POST /organizer/users/:id/reset-password
# inside the same PASSWORD_RESET_WINDOW_MS above. Only failures count and a
# correct password clears the organizer's window, so a working organizer never
# hits it. Over the ceiling the route answers the same 403 as a wrong password
# — telling the caller they were throttled would only narrow their search.
PASSWORD_RESET_ADMIN_MAX_PER_ORGANIZER=5

# AWS SES email sending (src/modules/notifications). SES_REGION,
# SES_ACCESS_KEY_ID and SES_SECRET_ACCESS_KEY are all optional — when any of
# the three is missing, notifications fall back to a console.log instead of a
# real send (this is what local dev and CI run with, no AWS account needed).
# The SES identity is per region, so SES_REGION must be the region where the
# sender identity was verified — see docs/deploy-checklist.md § 5.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=Liga de Algoritmos - PUCRS <contato@ligadealgoritmos.com>

# In-app bug reports (src/modules/bug-reports, #145). BUG_REPORT_TO_EMAIL is
# the inbox that receives every report sent from the app's floating button;
# it goes out through the same SES config above (and falls back to the same
# console.log when SES is not configured). While the SES account is still in
# the sandbox this address must itself be a verified identity, or the send
# fails — see docs/deploy-checklist.md § 5.
# BUG_REPORT_COOLDOWN_MS is the per-IP window on the public POST /bug-reports:
# one accepted report per IP per window, a second one inside it answers 429.
# The window is in-memory and process-local, so restarting the API clears it.
BUG_REPORT_TO_EMAIL=ligadealgoritmos@gmail.com
BUG_REPORT_COOLDOWN_MS=60000
