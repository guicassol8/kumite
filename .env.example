# Copy to .env. Two different stacks read this file, never the same one:
# docker-compose.yml (local development) and docker-compose.prod.yml (the
# VPS). A single .env does not serve both — fill in the section that matches
# the machine you are on and leave the other one out.
#
# Application secrets (JWT_SECRET, the SES credentials, the organizer seed)
# do NOT live here: they belong to back/.env, which docker-compose.prod.yml
# hands to the back container via env_file. See back/.env.example and
# docs/deploy-checklist.md.

# ── Local development (docker-compose.yml) ────────────────────────────────

# Host port for the compose Postgres (used by docker compose up -d at the
# repo root). Only needed when running a second stack in a parallel worktree
# — see docs/workflow.md § Worktrees.
DB_PORT=5433

# ── Production / VPS (docker-compose.prod.yml) ────────────────────────────
# Not read by docker-compose.yml. Required, no defaults:

# Password of the compose Postgres. Also builds the back container's
# DATABASE_URL (postgres://kumite:${POSTGRES_PASSWORD}@db:5432/kumite), so
# changing it once the volume exists breaks the app until the role is
# updated too. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# Domain Caddy serves and requests the TLS certificate for, and the address
# Let's Encrypt notifies about expiry. Both are read by the Caddyfile.
KUMITE_DOMAIN=
CADDY_EMAIL=

# Optional, both have a default — uncomment only to override it.

# GitHub owner of the ghcr.io package holding the back image
# (default: guicassol8).
# GHCR_OWNER=guicassol8

# Tag of the back image to run (default: latest). Pin a commit sha here to
# roll back to a specific build without touching the workflow.
# TAG=latest
